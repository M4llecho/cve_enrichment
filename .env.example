# CVE Enrichment System Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cve_enrichment

# NVD API Key (optional, but increases rate limit from 5 to 50 req/30sec)
# Get your key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# SSL/TLS
SSL_VERIFY=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
