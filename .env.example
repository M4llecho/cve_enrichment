# CVE Enrichment System Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cve_enrichment

# NVD API Key (optional, but increases rate limit from 5 to 50 req/30sec)
# Get your key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# SSL/TLS
SSL_VERIFY=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# LLM Configuration for CVE Tagging
# =============================================================================

# Backend: "ollama" (local) or "api" (cloud)
CVE_LLM_BACKEND=api

# API Provider (only if CVE_LLM_BACKEND=api)
# Options: gemini, deepseek, openai, anthropic, groq
CVE_LLM_API_PROVIDER=gemini

# API Keys - set only the one for your chosen provider
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama settings (only if CVE_LLM_BACKEND=ollama)
CVE_LLM_URL=http://localhost:11434
CVE_LLM_MODEL=deepseek-r1:8b
